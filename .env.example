APP_NAME="CRM Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_DEFAULT_LANGUAGE=fa
APP_THEME=default

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm_user
DB_PASSWORD=change_me

SESSION_COOKIE_NAME=crm_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax
SESSION_DOMAIN=

LOG_LEVEL=debug

# Auth (Phase 2)
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_THROTTLE_MINUTES=15

# Mail (Phase 2) — 'log' writes to storage/mail/ instead of sending.
# 'php_mail' uses the host's sendmail (no credentials). 'smtp' uses a
# real mailbox with AUTH LOGIN — set MAIL_SMTP_* below for that.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.com
# Leave MAIL_FROM_NAME commented out (not just empty — an empty value
# still counts as "set") to fall back to APP_NAME automatically, per
# config/mail.php. Uncomment only if you want a name different from
# APP_NAME.
# MAIL_FROM_NAME=

# Only used when MAIL_DRIVER=smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=ssl

# Set this to a long random string to enable GET /system/migrate?token=...
# (see docs/phase2-authentication.md). Leave empty to keep it disabled.
MIGRATE_TOKEN=

# Wallet module — ZarinPal. Get merchant_id from your ZarinPal panel;
# ZARINPAL_SANDBOX=true uses sandbox.zarinpal.com (test payments, no
# real money) until you're ready to go live.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Notification module — Bale bot. Get this from @botfather in Bale.
# Leave empty to keep Bale notifications disabled (they fail
# gracefully, logged as "not configured," rather than crashing).
BALE_BOT_TOKEN=
